{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.freema/pixelforge-mcp",
  "title": "PixelForge",
  "description": "Forge pixel art sprites, animations, tilesets and game assets with Google Gemini.",
  "repository": {
    "url": "https://github.com/freema/pixelforge-mcp",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "pixelforge-mcp",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GEMINI_API_KEY",
          "description": "Google Gemini API key (https://aistudio.google.com/apikey)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
